# Copy to `.env` next to docker-compose.yml and fill in. `.env` is gitignored.

# Postgres password, used by both the db and app services.
# Only applied when the pgdata volume is first created; changing it later
# leaves the database on the old password. It goes into DATABASE_URL unescaped,
# so avoid URL-special characters (@ : / ? # %); `openssl rand -hex 32` is safe.
POSTGRES_PASSWORD=change-me

# Host port for the app. Prefix with an IP to bind one interface only,
# e.g. the VPN address: APP_PORT=10.8.0.1:8080
APP_PORT=8080

# Host port for Postgres, always bound to 127.0.0.1 (for `make api` in development).
DB_PORT=5432

# IANA timezone that decides where "today" starts and ends.
APP_TIMEZONE=America/Vancouver

# Image tag to run from ghcr.io/marco-debortoli/ops-tasks (e.g. a version or commit SHA).
IMAGE_TAG=latest
